{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-ui",
  "description": "Lets the Stremio web UI talk to the shell",
  "windows": ["main"],
  "remote": {
    "urls": ["https://app.strem.io/*", "https://staging.strem.io/*", "http://127.0.0.1:11470/*"]
  },
  "permissions": ["allow-shell-props", "allow-shell-event"]
}
