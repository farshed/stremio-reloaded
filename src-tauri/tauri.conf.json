{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stremio Shell",
  "version": "4.4.183",
  "identifier": "com.stremio.desktop",
  "build": {
    "frontendDist": "https://app.strem.io/shell-v4.4/"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "resources/server.js": "server.cjs"
    }
  }
}
